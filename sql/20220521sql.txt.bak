KM » DB » SQL » 

 
常用語句
•將列表中多行數據合併爲一行

1.使用指定字段法
    declare @ret nvarchar(max)
    set @ret = ''
     select @ret=@ret +Role_Name+',' from dbo.v_Role_Member  
            where user_code= 'H0755830'  
     PRINT @ret


2.STUFF （（select * from FOR XML PATH('')),1,1,'')
  SELECT  　 STUFF(
(SELECT DISTINCT';'+b.User_Email 
   FROM dbo.usy_User_Role  a 
　　　　　 　LEFT JOIN dbo.usy_User b ON a.Factory_Code=b.Factory_Code AND a.User_Code=b.User_Code
　　　　　　　WHERE a.Role_Code LIKE '%dcc%' AND a.Factory_Code='BJ' FOR XML PATH('')),1,1,'')　AS Email 

SELECT tb.appsid,
    eqTest=
    STUFF(
    (
    　　SELECT ','+Control_Name+'('+Control_Code+')' FROM dbo.dat_CalibrationEqList WHERE AppsID=tb.AppsID for xml path('') 
    ),1,1,'')

     FROM  [dbo].[dat_CalibrationEqList] tb      GROUP BY  appsid


