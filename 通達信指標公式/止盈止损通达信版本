A:=ZIG(2,5);

FXDD:=A>REF(A,1) AND REF(A,2)>REF(A,1);

GDDZ:=IF(FXDD,REF(LOW,1),0);

支撑位:IF(GDDZ=0,REF(LOW,BARSLAST(FXDD)+1),REF(LOW,1)),NODRAW;

ZCW:IF(支撑位=REF(支撑位,1),支撑位,DRAWNULL);

B:=ZIG(1,5);

FXGD:=B<REF(B,1) AND REF(B,2)<REF(B,1);

GGDZ:=IF(FXGD,REF(HIGH,1),0);

压力位:IF(GGDZ=0,REF(HIGH,BARSLAST(FXGD)+1),REF(HIGH,1)),NODRAW;

YLW:IF(压力位=REF(压力位,1),压力位,DRAWNULL);

D:=ZIG(3,5);

FXCD:=D<REF(D,1) AND REF(D,2)<REF(D,1);

GCDZ:=IF(FXCD,REF(CLOSE,1),0);

止盈位:IF(GCDZ=0,REF(CLOSE,BARSLAST(FXCD)+1),REF(CLOSE,1)),NODRAW;

ZYW:IF(止盈位=REF(止盈位,1),止盈位,DRAWNULL);

FXDD1:=D>REF(D,1) AND REF(D,2)>REF(D,1);

GDDZ1:=IF(FXDD1,REF(CLOSE,1),0);

止损位:IF(GDDZ1=0,REF(CLOSE,BARSLAST(FXDD1)+1),REF(CLOSE,1)),NODRAW;

ZSW:IF(止损位=REF(止损位,1),止损位,DRAWNULL);
DRAWICON((支撑位>REF(支撑位,1)OR 支撑位<REF(支撑位,1)) AND CLOSE>支撑位,LOW,42);
DRAWTEXT((支撑位>REF(支撑位,1)OR 支撑位<REF(支撑位,1)) AND CLOSE>支撑位,LOW, VARCAT('开仓:  ', VAR2STR((HIGH+LOW)/2,2))), COLORFF00FF;
